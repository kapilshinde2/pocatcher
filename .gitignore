# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
logs/

# Secrets / local env (keep examples tracked with !)
.env
.env.*
!.env.example

# Local Docker overrides (machine-specific)
docker-compose.override.yml

# Java / Maven (any module)
**/target/
**/.classpath
**/.project
**/.settings/
**/.sts4-cache
**/.apt_generated
**/.factorypath

# Node / frontend (any package)
**/node_modules/
**/dist/
**/dist-ssr/
*.local

# Maven wrapper binary (often not committed)
**/.mvn/wrapper/maven-wrapper.jar
